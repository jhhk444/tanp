<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.dessertbackend.mapper.LoginRecordMapper">

    <select id="selectList" resultType="LoginRecord">
        SELECT id,username,ip_address,user_agent,login_time FROM login_record ORDER BY login_time DESC
    </select>

    <select id="count" resultType="int">
        SELECT COUNT(*) FROM login_record
    </select>

    <insert id="insert" parameterType="LoginRecord">
        INSERT INTO login_record(username,ip_address,user_agent,login_time)
        VALUES(#{username},#{ipAddress},#{userAgent},#{loginTime})
    </insert>
</mapper>